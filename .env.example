# ── Payment rails ───────────────────────────────────────────────────────────
# Every paid route offers BOTH rails in its 402 challenge; the client picks one.
# These are the suite's public receive addresses — change them to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# EVM network: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# EVM facilitator. The x402.org default only settles base-sepolia — switch to a
# mainnet facilitator (e.g. https://facilitator.payai.network) with NETWORK=base.
FACILITATOR_URL=https://x402.org/facilitator
# Solana facilitator. PayAI's public lane needs no API key and sponsors the SOL fee.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Solana RPC used by browser checkout helpers (the public RPC is rate limited).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Facilitator sponsor account that pays the SOL network fee. Public, not a secret.
SOLANA_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4

# ── Signing ─────────────────────────────────────────────────────────────────
# HMAC-SHA256 key for the signature on every record and status snapshot.
# Unset falls back to an insecure dev default — set this before anyone verifies
# your signatures for real.
SIGNING_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4021
